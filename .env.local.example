# Google Cloud Console → Enable "Places API (New)" → Create API Key
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Anthropic Console → https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hunter.io API key → https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_api_key_here

# Supabase PostgreSQL — both URLs from Supabase dashboard → Settings → Database
# DATABASE_URL = "Transaction" pooler connection string (port 6543) — used by the app
# DIRECT_URL   = "Session" mode / direct connection string (port 5432) — used by migrations
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
